<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<LangVersion>latest</LangVersion>
		<IsRoslynComponent>true</IsRoslynComponent>
		<IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <Company>Reflection IT</Company>
        <Copyright>©2025-2026 Reflection IT</Copyright>
        <PackageIcon>Logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>A source generator package that implements the dispose and async dispose patterns</Description>
		<RepositoryUrl>https://github.com/sonnemaf/ReflectionIT.DisposeGenerator</RepositoryUrl>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageReleaseNotes>
            - More analyzers
            - GitHub Copilot suggested improvements
        </PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" />
		<None Include="..\LICENSE.txt">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

    <ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="Logo.png" Pack="True" PackagePath="\" />
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(OutputPath)\ReflectionIT.DisposeGenerator.Attributes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(OutputPath)\ReflectionIT.DisposeGenerator.Attributes.dll" Pack="true" PackagePath="lib\netstandard2.0" Visible="false" />
        <None Include="$(OutputPath)\ReflectionIT.DisposeGenerator.Attributes.xml" Pack="true" PackagePath="lib\netstandard2.0" Visible="false" />
    </ItemGroup>
    
    <ItemGroup>
	  <ProjectReference Include="..\ReflectionIT.DisposeGenerator.Attributes\ReflectionIT.DisposeGenerator.Attributes.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>ReflectionIT.DisposeGenerator.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
